generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collaborator {
  id                    String                  @id @default(uuid())
  name                  String                  @db.VarChar(50)
  description           String
  createdAt             DateTime                @default(now())
  updatedAt             DateTime?
  collaboratorsServices CollaboratorsService[]
  schedullings          Schedulling[]
  photos                CustomerPhoto[]
}

model CollaboratorsService {
  id             String       @id @default(uuid())
  collaboratorId String
  serviceId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([collaboratorId, serviceId])
}

model Customer {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  password     String
  birthDate    DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime?       @updatedAt
  schedullings Schedulling[]
  photos       CustomerPhoto[]
}

model Hour {
  id           String        @id @default(uuid())
  hour         Int
  days         Int[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime?     @updatedAt
  schedullings Schedulling[]
}

model Schedulling {
  id             String       @id @default(uuid())
  serviceId      String
  hourId         String
  collaboratorId String
  customerId     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime?    @updatedAt
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  hour           Hour         @relation(fields: [hourId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, customerId, hourId, collaboratorId])
}

model Service {
  id                    String                  @id @default(uuid())
  name                  String
  description           String
  duration              Int
  price                 BigInt
  createdAt             DateTime                @default(now())
  updatedAt             DateTime?               @updatedAt
  collaboratorsServices CollaboratorsService[]
  schedullings          Schedulling[]
  photos                CustomerPhoto[]
}

model CustomerPhoto {
  id         String    @id @default(uuid())
  name       String
  url        String    @default("")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  customerId     String?
  collaboratorId String?
  serviceId      String?

  customer    Customer?    @relation(fields: [customerId], references: [id])
  collaborator Collaborator? @relation(fields: [collaboratorId], references: [id])
  service     Service?     @relation(fields: [serviceId], references: [id])

  @@index([customerId])
  @@index([collaboratorId])
  @@index([serviceId])
  @@map("user_photos")
}
